{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "group:allNonMajor", ":preserveSemverRanges", ":disablePeerDependencies"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi-rs/cli", "napi", "napi-derive", "napi-build"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "matchPackageNames": ["@emnapi/core", "@emnapi/runtime", "@tybys/wasm-util"],
      "groupName": "emnapi"
    },
    {
      "matchPackageNames": ["oxlint", "oxfmt"],
      "addLabels": ["tooling"],
      "groupName": "oxc"
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": []
}
