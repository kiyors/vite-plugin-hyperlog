{
  "name": "vite-plugin-hyperlog",
  "version": "0.2.0",
  "description": "High-performance Vite plugin for request and browser logging, powered by Rust",
  "keywords": [
    "browser-logger",
    "hyperlog",
    "logger",
    "request-logger",
    "vite",
    "vite-plugin",
    "vite-plugin-hyperlog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kiyors/vite-plugin-hyperlog.git"
  },
  "files": [
    "dist/",
    "index.d.ts",
    "index.js",
    "src/",
    "*.node"
  ],
  "main": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": "./dist/plugin.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./react": "./dist/react.mjs",
    "./solid": "./dist/solid.mjs",
    "./svelte": "./dist/svelte.mjs",
    "./tanstack": "./dist/tanstack.mjs",
    "./tanstack/client": "./dist/tanstack-client.mjs",
    "./tanstack-client": "./dist/tanstack-client.mjs",
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && tsdown",
    "build:debug": "napi build --platform",
    "build:ts": "tsdown",
    "fmt": "run-p fmt:rs fmt:oxfmt",
    "fmt:oxfmt": "oxfmt",
    "fmt:rs": "cargo fmt",
    "lint": "run-p lint:rs lint:oxlint",
    "lint:oxlint": "oxlint .",
    "lint:rs": "cargo clippy",
    "test": "vitest run",
    "test:unit": "vitest run test/unit.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "test:watch": "vitest",
    "bench": "node --expose-gc scripts/benchmark.mjs",
    "bench:quick": "node scripts/benchmark.mjs",
    "preversion": "napi build --platform && tsdown && git add .",
    "version": "napi build --platform && tsdown && git add index.js dist/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.10.6",
    "@oxlint/plugins": "1.86.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.4",
    "chalk": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "tree-kill": "^1.2.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.@(yml|yaml|md|json|toml)": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "napi": {
    "binaryName": "vite-plugin-hyperlog",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "packageManager": "pnpm@12.3.4"
}
