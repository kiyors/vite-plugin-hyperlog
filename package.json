{
  "name": "@kiyors/vite-plugin-logger",
  "version": "0.0.10",
  "description": "High-performance Vite plugin for request and browser logging, powered by Rust",
  "keywords": [
    "browser-logger",
    "logger",
    "request-logger",
    "vite",
    "vite-plugin",
    "vite-plugin-logger"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kiyors/vite-plugin-logger.git"
  },
  "files": [
    "dist/",
    "index.d.ts",
    "index.js",
    "lib/",
    "*.node"
  ],
  "exports": {
    ".": "./dist/plugin.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && tsdown",
    "build:debug": "napi build --platform",
    "build:ts": "tsdown",
    "fmt": "run-p fmt:rs fmt:oxfmt",
    "fmt:oxfmt": "oxfmt",
    "fmt:rs": "cargo fmt",
    "lint": "oxlint .",
    "test": "echo 'No tests yet'",
    "preversion": "napi build --platform && tsdown && git add .",
    "version": "napi build --platform && tsdown && git add index.js dist/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.8.6",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.3",
    "chalk": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.@(yml|yaml|md|json|toml)": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "napi": {
    "binaryName": "vite-plugin-logger",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "packageManager": "pnpm@11.18.0"
}
